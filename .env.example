# 复制为 .env.local 并按需填写。生产部署请在部署平台注入同名环境变量。

# 会话/登录令牌签名密钥（改动会使历史令牌全部失效）。生产环境务必设置强随机值。
# GRIS_AUTH_SECRET=

# Google Places（真实竞品数据）。配置后 /api/scout/places 走真实 Nearby Search；
# 未配置则自动降级为明确标注「演示」的 POI，系统仍可运行。
# 用户稍后提供。开通：Google Cloud Console → 创建 API key → 启用 "Places API"。
# GOOGLE_PLACES_API_KEY=

# 是否开启「首个访客直通演示会话」（跳过登录页）。默认开启；正式环境设为 0 关闭。
# 0 = 关闭游客直通，强制登录
# GRIS_DEMO_ANON=1